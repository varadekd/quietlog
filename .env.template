# ------------------------------------------------------------
# quietlog configuration
# Copy this file to `.env` and adjust values as needed.
# All variables are optional — sensible defaults are used.
# ------------------------------------------------------------

# Application name
# Used in log prefix and default log file name
# Default: app
APP_NAME=app


# Enable or disable colored logs
# Recommended: true for local/dev, false for production
# Default: true
LOG_COLOR=true


# Log file path
# If not provided, quietlog creates:
#   ./<app_name>_<timestamp>.log
#
# Example:
# LOG_FILE_PATH=./logs/app.log
#
# Default: auto-generated
# LOG_FILE_PATH=


# Maximum number of log lines before reset
# This is a simple safeguard, not a rotation mechanism
# Recommended to use external log rotation in production
# Default: 1000
LOG_LINES=1000


# Log format (order matters)
# Allowed fields:
#   AppName
#   Level
#   Timestamp
#   Message
#
# Example formats:
# LOG_FORMAT=AppName,Level,Timestamp,Message
# LOG_FORMAT=Timestamp,Level,Message
# LOG_FORMAT=Level,Message
#
# Default: AppName,Level,Timestamp,Message
LOG_FORMAT=AppName,Level,Timestamp,Message


# Timestamp format (Go time format)
# Reference: https://pkg.go.dev/time#Time.Format
#
# Example:
# LOG_TIME_FORMAT=2006-01-02 15:04:05
#
# Default: 02-Jan-2006 15:04:05
LOG_TIME_FORMAT=02-Jan-2006 15:04:05
